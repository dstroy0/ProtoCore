# What a feature needs. These were `#error` rules in feature_dependency_en.h; a build that
# asks for a feature without what it rests on now fails at CONFIGURE, naming both, instead of
# part way through a compile.
function(protocore_requires child parent)
  if(${child} AND NOT ${parent})
    message(FATAL_ERROR "${child} needs ${parent}")
  endif()
endfunction()

