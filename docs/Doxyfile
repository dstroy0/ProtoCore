#---------------------------------------------------------------------------
# Project identity
#---------------------------------------------------------------------------
PROJECT_NAME           = "ProtoCore"
PROJECT_BRIEF          = "Deterministic, zero-heap network stack for embedded targets"
PROJECT_NUMBER         = "v1.0.16"
PROJECT_LOGO           =

#---------------------------------------------------------------------------
# Input / output
#---------------------------------------------------------------------------
# Each examples/ README is a page of the site, and docs/EXAMPLES.md lists each one with @subpage, so it
# nests under that index. IMPLICIT_DIR_DOCS is NO, because a README that documents its directory is not a page,
# and then the @subpage name has no target. The .ino, .cpp and .h sources of the examples stay out, because
# each README holds its source, and the file list stays the API reference.
INPUT                  = src docs examples README.md
FILE_PATTERNS          = *.h *.cpp *.ino *.md
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_PATTERNS       = */test/* */docs/html/* */ci_tooling/generate/* */docs/Doxyfile */docs/cliff.toml */docs/custom.css */examples/*.ino */examples/*.cpp */examples/*.h */examples/esp-idf/*
USE_MDFILE_AS_MAINPAGE = docs/README.md
IMPLICIT_DIR_DOCS      = NO
MARKDOWN_ID_STYLE      = GITHUB

OUTPUT_DIRECTORY       = docs/html
CREATE_SUBDIRS         = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
# XML is consumed by Breathe to render the API reference into the Sphinx site (docs/sphinx).
GENERATE_XML           = NO  # was feeding docs/sphinx/xml for Breathe; that site is gone
XML_OUTPUT             = ../sphinx/xml  # unused while GENERATE_XML=NO
XML_PROGRAMLISTING     = NO
GENERATE_MAN           = NO

#---------------------------------------------------------------------------
# Extraction settings
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_GROUPED_MEMB_INC  = YES
SHOW_USED_FILES        = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
# Each dispatch table of a header is static const, so EXTRACT_STATIC is YES, and the site shows the tables.
# The MMgr macros of a declaration come from a header outside INPUT, so each one has its expansion here.
# EXPAND_ONLY_PREDEF is YES, so each ProtoCore macro of a table declaration has its expansion here too.
PREDEFINED             = ARDUINO \
                         DOXYGEN \
                         EMBED_BEGIN_DECLS= \
                         EMBED_END_DECLS= \
                         "EMBED_INLINE=static inline" \
                         "EMBED_ENUM_BYTE(name_, ...)=typedef enum { __VA_ARGS__ } name_;" \
                         __attribute__(x)= \
                         "PROTOCORE_NS=static const" \
                         PROTOCORE_UNUSED= \
                         "PROTOCORE_NS_LAYOUT(type_, ...)="
# BEGIN GENERATED doxygen_features (tools/ci_tooling/generate/gen_doxygen_features.py)
