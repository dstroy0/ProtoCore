{
  "name": "ProtoCore",
  "version": "1.0.16",
  "description": "Zero-heap, asynchronous multi-protocol network server with a fully deterministic memory footprint. HTTP/1.1 and HTTP/2 (HTTP/3 over QUIC in progress) plus WebSocket (RFC 6455), Server-Sent Events, Basic/Digest auth, file serving, multipart, JSON, templating, and a middleware pipeline; optional HTTPS/TLS, SSH, Telnet, and SNMP (v1/v2c/v3). All buffers statically sized at compile time; feature flags strip unused subsystems.",
  "keywords": [
    "esp32",
    "http",
    "http2",
    "quic",
    "web server",
    "websocket",
    "sse",
    "ssh",
    "telnet",
    "tls",
    "https",
    "snmp",
    "async",
    "deterministic",
    "rfc7230",
    "lwip"
  ],
  "homepage": "https://dstroy0.github.io/ProtoCore/",
  "authors": [
    {
      "name": "Douglas Quigg",
      "email": "dquigg123@gmail.com",
      "url": "https://github.com/dstroy0",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dstroy0/ProtoCore.git"
  },
  "license": "AGPL-3.0-or-later",
  "frameworks": ["arduino"],
  "platforms": ["espressif32"],
  "headers": ["protocore.h"],
  "export": {
    "exclude": [
      ".github",
      ".gitignore",
      "test/[!c]*",
      "test/compile_commands.json",
      "test/coverage.xml",
      "platformio.ini",
      ".bumpversion.cfg",
      "cspell.json",
      ".clang-format",
      ".prettierignore",
      ".editorconfig",
      "package.json",
      "docs/html",
      "docs/utilities",
      "docs/Doxyfile",
      "docs/cliff.toml",
      "docs/header.html",
      "docs/footer.html",
      "docs/custom.css",
      "docs/custom_doxygen.css"
    ]
  },
  "build": {
    "srcDir": ".",
    "srcFilter": [
      "-<*>",
      "+<src/>",
      "+<include/MMgr/src/clz/clz.c>",
      "+<include/MMgr/src/impensa_ancorae_acus/impensa_ancorae_acus_generic.c>",
      "+<include/MMgr/src/ascii_persona_bitorum/ascii_persona_bitorum.c>",
      "+<include/MMgr/src/bitorum_introitus_exitus/bitorum_introitus_exitus.c>",
      "+<include/MMgr/src/endian/endian.c>",
      "+<include/MMgr/src/proximus_operor/proximus_operor.c>",
      "+<include/MMgr/src/verbum_scrutor/verbum_scrutor.c>",
      "+<include/MMgr/src/memoria_operor/memoria_operor.c>",
      "+<include/MMgr/src/cellularum_laboro/cellularum_laboro.c>",
      "+<include/MMgr/src/spatium/spatium.c>",
      "+<include/MMgr/src/octetus_introitus_exitus/octetus_introitus_exitus.c>",
      "+<include/MMgr/src/locus_carcerum/locus_carcerum.c>",
      "+<include/MMgr/src/memoria_anularis/memoria_anularis.c>",
      "+<include/MMgr/src/memoria_externa/memoria_externa.c>",
      "+<include/MMgr/src/transformo/transformo.c>",
      "+<include/MMgr/src/memoriam_praetereo/memoriam_praetereo.c>",
      "+<include/MMgr/src/memoriam_praetereo/praet_ordo.c>",
      "+<include/MMgr/src/memoriam_praetereo/praet_descriptor.c>",
      "+<include/MMgr/src/fractio/fractio.c>",
      "+<include/MMgr/src/verba_scribo/verba_scribo.c>",
      "+<include/MMgr/src/verba_scribo/verba_linea.c>",
      "+<include/MMgr/src/numeros_scribo/numeros_scribo.c>",
      "+<test/core_setup/>",
      "-<test/core_setup/idemIP/>",
      "-<test/core_setup/boot/>"
    ],
    "unflags": ["-std=gnu99"],
    "flags": [
      "-std=gnu11",
      "-I include",
      "-I src",
      "-I include/MMgr/include",
      "-I include/MMgr/src",
      "-I include/embedded_types/include"
    ]
  }
}
