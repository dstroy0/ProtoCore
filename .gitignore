.pio
.vscode/
# npm dev tooling (prettier/cspell); package.json + package-lock.json are committed, node_modules is not
node_modules/
# Root CMake build dir (the ESP-IDF component's CMakeLists lives at root; `cmake .` / idf.py creates build/)
/build/
docs/html
# Python (asset generator tooling)
__pycache__/
*.pyc
# Generated C/C++ compilation database - the root copy is the machine-specific scan
# copy (@ROOT@ expanded), regenerated in CI by ci_tooling/sonar/gen_compiledb.sh. The
# host-independent baseline test/compile_commands.json IS committed (affected runs
# overlay only the changed envs onto it), so un-ignore it.
compile_commands.json
!test/compile_commands.json
compiledb_frags/
# Instrumented build dir + per-env report fragments (regenerated by ci_tooling/coverage/gen_coverage.sh).
# test/coverage.xml itself is COMMITTED and updated incrementally by the Test & Analyze workflow, so
# only ignore a stray root-level coverage.xml here, not the tracked one under test/.
/coverage.xml
coverage_reports/
.pio_cov/
.pio_cov_wsl/
docs/favicons/dist/

# pentest rig run artifact (generated)
rig_report.json

# local CodeQL pre-ship gate output (SARIF copied back from a local WSL runner
# script). The CI CodeQL workflow is the source of truth.
.codeql-local/

# Espressif datasheet PDFs pulled for local reference while building src/board_drivers/board_profiles/.
# Not committed - binary, ~9 MB, and this is a published library. docs/reference/README.md
# links the online copies instead.
docs/reference/*.pdf

# Espressif/Waveshare Flash Download Tool (local flashing GUI, ~26 MB binary) - not committed.
tools/flash_download_tool/

# local coverage scratch (ci_tooling/coverage/covrun.py, covbase.py)
.pio_*/
.cov_*/
.cov_*.xml
.covbase*.log
coverage_reports/
*.gcov

# arduino-cli --build-path output for the rig bench sketches (~75 MB each, incl. a 16 MB
# merged.bin); regenerated by penetration_testing/rig_firmware/*/build_*.sh.
penetration_testing/rig_firmware/*/*/build/

# arduino-cli default output when compiling an example in place (~30 MB each); regenerated by
# ci_tooling/check/compile_examples.sh and the local esp_compile helper.
examples/*/*/build/

# The LTO variant build dir for the rig bench sketches (the plain build/ is covered above).
penetration_testing/rig_firmware/*/*/build-lto/

# Downloaded by the Docs workflow at build time (pinned doxygen-awesome-css v2.3.3), not source.
docs/doxygen-awesome.css

# ESP-IDF component manager output, written next to whichever project is built (the examples
# under examples/esp-idf/). managed_components/ is the registry download (arduino-esp32 is
# ~200 MB of it) and dependencies.lock is its resolved graph - both regenerate from
# idf_component.yml, so neither is source. The build dirs themselves are covered above.
managed_components/
dependencies.lock

# idf.py writes the resolved config next to the project; sdkconfig.defaults is the source and
# stays tracked. sdkconfig is generated from it per target and sdkconfig.old is its backup.
sdkconfig
sdkconfig.old
