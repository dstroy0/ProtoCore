{
  "name": "protocore-ci-tooling",
  "version": "v0.0.0",
  "private": true,
  "description": "Dev/CI tooling manifest for ProtoCore.",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://dstroy0.github.io/ProtoCore/",
  "repository": {
    "type": "git",
    "url": "https://github.com/dstroy0/ProtoCore.git"
  },
  "bugs": {
    "url": "https://github.com/dstroy0/ProtoCore/issues"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{md,json,yml,yaml,css,html,js,cjs,mjs}\"",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml,css,html,js,cjs,mjs}\"",
    "spell": "cspell --config cspell.json \"**/*.md\""
  },
  "devDependencies": {
    "cspell": "^10.0.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=18"
  }
}
